# Copy to .env.local (or set in the Vercel project) and restart.
# The server checks these when it starts (src/instrumentation.ts) and lists any
# that are missing or malformed by name.

# --- Supabase (required): teacher sign-in and the database.
# Project settings → API keys. Use the new keys, not the legacy anon and
# service_role keys. The publishable key is public by design; row-level security
# protects the data. The secret key bypasses it: server only, never NEXT_PUBLIC_.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...

# --- AI drafting. Gemini is Funza's provider; set GEMINI_API_KEY.
# Use the free-tier development key only with made-up data. Without a key Funza
# still runs: teachers start from Funza's question bank or write materials themselves.
# /api/teach answers only signed-in teachers (development step 3). Put the free-tier
# development key in Vercel's Preview environment only once step 3 is merged.
# GEMINI_API_KEY=
# FUNZA_AI_MODEL=               # optional override of the default model
#
# Development stand-ins (OpenAI-compatible), used only when no Gemini key is set:
# GROQ_API_KEY=                 # free tier; default llama-3.3-70b-versatile
# OPENROUTER_API_KEY=           # free models; default meta-llama/llama-3.3-70b-instruct:free
# FUNZA_AI_PROVIDER=            # gemini | groq | openrouter, to force one when several keys are set
# FUNZA_AI_API_KEY=             # the key for that provider
# FUNZA_AI_BASE_URL=            # optional: another OpenAI-compatible endpoint (a test double)

# --- Google Classroom publishing. All three are needed; without them Funza says
# Classroom is not set up and offers printing only.
# GOOGLE_CLIENT_ID=             # OAuth client ID, type "Web application"
# GOOGLE_CLIENT_SECRET=         # its secret
# FUNZA_SESSION_SECRET=         # 32+ random characters; encrypts the teacher's Google token cookie
