# Copy to .env.local and fill in ONE provider. Without a key the app still runs;
# question sheets then offer guidance from your notes but cannot solve questions.
#
# FUNZA_AI_PROVIDER=groq        # anthropic | groq | openrouter | gemini
# FUNZA_AI_API_KEY=             # the key for that provider
# FUNZA_AI_MODEL=               # optional override of the provider's default model
#
# Or set the provider's own variable and leave the three above empty:
# ANTHROPIC_API_KEY=            # paid; default model claude-opus-5-5
# GROQ_API_KEY=                 # free tier; default llama-3.3-70b-versatile
# OPENROUTER_API_KEY=           # free models; default meta-llama/llama-3.3-70b-instruct:free
# GEMINI_API_KEY=               # free tier; default gemini-2.5-flash
# FUNZA_AI_BASE_URL=            # optional: point groq/openrouter-style (OpenAI-compatible) calls at another endpoint, e.g. a self-hosted model
