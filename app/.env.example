# Copy to .env.local (or set in the Vercel project) and restart.

# --- AI drafting: set ONE provider. Without a key Funza still runs: teachers
# start from Funza's question bank or write resources themselves.
# FUNZA_AI_PROVIDER=groq        # anthropic | groq | openrouter | gemini
# FUNZA_AI_API_KEY=             # the key for that provider
# FUNZA_AI_MODEL=               # optional override of the provider's default model
#
# Or set the provider's own variable and leave the three above empty:
# ANTHROPIC_API_KEY=            # paid; default model claude-opus-5-5
# GROQ_API_KEY=                 # free tier; default llama-3.3-70b-versatile
# OPENROUTER_API_KEY=           # free models; default meta-llama/llama-3.3-70b-instruct:free
# GEMINI_API_KEY=               # free tier; default gemini-2.5-flash
# FUNZA_AI_BASE_URL=            # optional: an OpenAI-compatible endpoint for groq/openrouter-style calls

# --- Google Classroom publishing. All three are needed; without them the
# Publish screen says Classroom is not set up and offers printing only.
# GOOGLE_CLIENT_ID=             # OAuth client ID, type "Web application"
# GOOGLE_CLIENT_SECRET=         # its secret
# FUNZA_SESSION_SECRET=         # 32+ random characters; encrypts the teacher's Google token cookie

