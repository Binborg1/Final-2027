{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/register.mjs --test \"tests/**/*.test.ts\"",
    "db:start": "supabase --workdir db db start",
    "db:stop": "supabase --workdir db db stop",
    "db:reset": "supabase --workdir db db reset",
    "db:test": "supabase --workdir db test db",
    "db:types": "supabase --workdir db gen types typescript --local > src/lib/db/types.ts",
    "db:schema": "supabase --workdir db db dump --local --schema public -f schema.sql",
    "live:load": "node scripts/live-load.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "pdfjs-dist": "6.4.299",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
